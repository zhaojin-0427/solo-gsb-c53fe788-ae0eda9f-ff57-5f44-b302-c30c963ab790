# Copy to .env to override defaults. All settings are prefixed with TS_.
TS_DATABASE_URL=postgresql+asyncpg://tail:tail@localhost:5432/tailsampling
# Idle window: a trace with no new spans for this long is closed and evaluated.
TS_WINDOW_MS=30000
# Hard watermark measured from the first span of a revision; past it an
# un-closed trace is archived as INDETERMINATE.
TS_HARD_WATERMARK_MS=60000
# Background sweep cadence.
TS_SWEEP_INTERVAL_MS=1000
# Set to false to disable the background sweeper (tests drive it manually).
TS_ENABLE_SWEEPER=true
# Seed the built-in v1 policy on first boot.
TS_SEED_DEFAULT_POLICY=true
# A PENDING idempotency placeholder whose owner clearly died (its row lock is
# freely acquirable) may be taken over after this many ms. Normal business
# failures are published as FAILED immediately, so this only covers hard
# crashes / lost connections.
TS_IDEMPOTENCY_PENDING_TTL_MS=60000
# Test-only fault-injection endpoints (/admin/test/*). Never enable in
# production; the Docker image and docker-compose.yml leave this disabled.
TS_ENABLE_TEST_HOOKS=false
